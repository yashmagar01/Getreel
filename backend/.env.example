# Groq API Key — used for Whisper transcription AND Llama 3.3 roadmap generation
# Get free at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Google Gemini API Key — used for multimodal concept extraction
# Get free at: https://aistudio.google.com
GOOGLE_API_KEY=your_google_gemini_api_key

# Supabase — used for caching results and rate limiting
# Get from your Supabase project Settings → API
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Path to Instagram cookies file on Render
# Upload as a Secret File on Render → /etc/secrets/cookies.txt
# See README.md for how to export this from your browser
INSTAGRAM_COOKIES_PATH=/etc/secrets/cookies.txt

# Vercel frontend URL — used for CORS (no trailing slash)
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# Layer 0: Burner Instagram account (dedicated, not your main account)
# This account will post comments and read DMs to intercept creator bot links
INSTAGRAM_BURNER_USERNAME=
INSTAGRAM_BURNER_PASSWORD=
